# Copie este arquivo para .env e ajuste os valores.
# Exemplo (PowerShell): Copy-Item .env.example .env

# Streaming (true/false)
IUNO_STREAM=true

# Voz
IUNO_VOICE_IN=false
IUNO_VOICE_OUT=false

# Entrada por voz
# file = pede caminho de um WAV
# mic  = grava direto do microfone (push-to-talk)
IUNO_VOICE_IN_MODE=file

# Idioma do STT (ex.: pt-BR, en-US)
IUNO_STT_LANG=pt-BR

# Microfone (apenas quando IUNO_VOICE_IN_MODE=mic)
IUNO_MIC_SAMPLE_RATE=16000
IUNO_MIC_CHANNELS=1

# TTS (opcional)
# IUNO_TTS_RATE=180
# IUNO_TTS_VOLUME=0.9
# IUNO_TTS_VOICE=
