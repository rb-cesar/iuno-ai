# Copie este arquivo para .env e ajuste os valores.
# Exemplo (PowerShell): Copy-Item .env.example .env

# Streaming (true/false)
IUNO_STREAM=true

# Voz
IUNO_VOICE_IN=false
IUNO_VOICE_OUT=false

# Idioma do STT (ex.: pt-BR, en-US)
IUNO_STT_LANG=pt-BR

# TTS (opcional)
# IUNO_TTS_RATE=180
# IUNO_TTS_VOLUME=0.9
# IUNO_TTS_VOICE=

